      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_003",
      "originalFrench": "Les camarades qui m'ont revu ont été bien contents de me revoir vivant.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_004",
      "originalFrench": "J'étais triste mais je leur disais: C'est la fatigue...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p1:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_005",
      "originalFrench": "Maintenant je me suis un peu consolé.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
