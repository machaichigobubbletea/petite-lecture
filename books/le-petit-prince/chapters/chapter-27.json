    {
      "id": "chapter_27_sentence_007",
      "originalFrench": "Mais je sais bien qu'il est revenu à sa planète, car, au lever du jour, je n'ai pas retrouvé son corps.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p2:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_008",
      "originalFrench": "Ce n'était pas un corps tellement lourd...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p2:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_009",
      "originalFrench": "Et j'aime la nuit écouter les étoiles.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p2:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_010",
      "originalFrench": "C'est comme cinq cent millions de grelots...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p2:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_011",
      "originalFrench": "Mais voilà qu'il se passe quelque chose d'extraordinaire.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_012",
      "originalFrench": "La muselière que j'ai dessinée pour le petit prince, j'ai oublié d'y ajouter la courroie de cuir!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p3:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_013",
      "originalFrench": "Il n'aura jamais pu l'attacher au mouton.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p3:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_014",
      "originalFrench": "Alors je me demande: \"Que s'est-il passé sur sa planète?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p3:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_015",
      "originalFrench": "Peut-être bien que le mouton à mangé la fleur...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p3:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_016",
      "originalFrench": "Tantôt je me dis: \"Sûrement non!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_017",
      "originalFrench": "Le petit prince enferme sa fleur toutes les nuits sous son globe de verre, et il surveille bien son mouton...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p4:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_018",
      "originalFrench": "Alors je suis heureux.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p4:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_019",
      "originalFrench": "Et toutes les étoiles rient doucement.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p4:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_020",
      "originalFrench": "Tantôt je me dis: \"On est distrait une fois ou l'autre, et ça suffit!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_021",
      "originalFrench": "Il a oublié, un soir, le globe de verre, ou bien le mouton est sorti sans bruit pendant la nuit...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p5:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_022",
      "originalFrench": "Alors les grelots se changent tous en larmes!...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p5:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_023",
      "originalFrench": "C'est là un bien grand mystère.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_024",
      "originalFrench": "Pour vous qui aimez aussi le petit prince, comme pour moi, rien de l'univers n'est semblable si quelque part, on ne sait où, un mouton que nous ne connaissons pas a, oui ou non, mangé une rose...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p6:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_025",
      "originalFrench": "Regardez le ciel.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_026",
      "originalFrench": "Demandez-vous: le mouton oui ou non a-t-il mangé la fleur?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p7:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_027",
      "originalFrench": "Et vous verrez comme tout change...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p7:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_028",
      "originalFrench": "Et aucune grande personne ne comprendra jamais que ça a tellement d'importance!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_029",
      "originalFrench": "Ça c'est, pour moi, le plus beau et le plus triste paysage du monde.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_030",
      "originalFrench": "C'est le même paysage que celui de la page précédente, mais je l'ai dessiné une fois encore pour bien vous le montrer.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_031",
      "originalFrench": "C'est ici que le petit prince a apparu sur terre, puis disparu.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap27:p9:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_27_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_032",
      "originalFrench": "Regardez attentivement ce paysage afin d'être sûrs de le reconnaître, si vous voyagez un jour en Afrique, dans le désert.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
