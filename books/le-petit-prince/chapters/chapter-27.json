      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_27_sentence_002",
      "originalFrench": "Je n'ai jamais encore raconté cette histoire.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
