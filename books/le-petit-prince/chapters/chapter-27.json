  "sentences": [
    {
      "id": "chapter_27_sentence_001",
      "originalFrench": "Et maintenant, bien sûr, ça fait six ans déjà...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
