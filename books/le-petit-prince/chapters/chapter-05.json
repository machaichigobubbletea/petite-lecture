  "sentences": [
    {
      "id": "chapter_05_sentence_001",
      "originalFrench": "Chaque jour j'apprenais quelque chose sur la planète, sur le départ, sur le voyage.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_002",
      "originalFrench": "Ça venait tout doucement, au hasard des réflexions.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_003",
      "originalFrench": "C'est ainsi que, le troisième jour, je connus le drame des baobabs.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_004",
      "originalFrench": "Cette fois-ci encore ce fut grâce au mouton, car brusquement le petit prince m'interrogea, comme pris d'un doute grave:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_005",
      "originalFrench": "-C'est bien vrai, n'est-ce pas, que les moutons mangent les arbustes?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_006",
      "originalFrench": "-Oui.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_007",
      "originalFrench": "C'est vrai.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p4:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_008",
      "originalFrench": "-Ah!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_009",
      "originalFrench": "Je suis content!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p5:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_010",
      "originalFrench": "Je ne compris pas pourquoi il était si important que les moutons mangeassent les arbustes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_011",
      "originalFrench": "Mais le petit prince ajouta:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p6:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_012",
      "originalFrench": "-Par conséquent ils mangent aussi les baobabs?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_013",
      "originalFrench": "Je fis remarquer au petit prince que les baobabs ne sont pas des arbustes, mais des arbres grand comme des églises et que, si même il emportait avec lui tout un troupeau d'éléphants, ce troupeau ne viendrait pas à bout d'un seul baobab.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_014",
      "originalFrench": "L'idée du troupeau d'éléphants fit rire le petit prince:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_015",
      "originalFrench": "-Il faudrait les mettre les uns sur les autres...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p10:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_016",
      "originalFrench": "Mais il remarqua avec sagesse:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p11:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_011",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_017",
      "originalFrench": "-Les baobabs, avant de grandir, ça commence par être petit.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p12:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_012",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_018",
      "originalFrench": "-C'est exact!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p13:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_013",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_019",
      "originalFrench": "Mais pourquoi veux-tu que tes moutons mangent les petits baobabs?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p13:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_013",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_020",
      "originalFrench": "Il me répondit: \"Ben!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p14:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_014",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_021",
      "originalFrench": "Voyons!\" comme s'il s'agissait là d'une évidence.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p14:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_014",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_022",
      "originalFrench": "Et il me fallut un grand effort d'intelligence pour comprendre à moi seul ce problème.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p14:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_014",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_023",
      "originalFrench": "Et en effet, sur la planète du petit prince, il y avait comme sur toutes les planètes, de bonnes herbes et de mauvaises herbes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_024",
      "originalFrench": "Par conséquent de bonnes graines de bonnes herbes et de mauvaises graines de mauvaises herbes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_025",
      "originalFrench": "Mais les graines sont invisibles.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_026",
      "originalFrench": "Elles dorment dans le secret de la terre jusqu'à ce qu'il prenne fantaisie à l'une d'elles de se réveiller.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_027",
      "originalFrench": "Alors elle s'étire, et pousse d'abord timidement vers le soleil une ravissante petite brindille inoffensive.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_028",
      "originalFrench": "S'il s'agit d'une brindille de radis ou de rosier, on peut la laisser pousser comme elle veut.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_029",
      "originalFrench": "Mais s'il s'agit d'une mauvaise plante, il faut arracher la plante aussitôt, dès qu'on a su la reconnaître.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_030",
      "originalFrench": "Or il y avait des graines terribles sur la planète du petit prince...c'étaient les graines de baobabs.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s8",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_031",
      "originalFrench": "Le sol de la planète en était infesté.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s9",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_032",
      "originalFrench": "Or un baobab, si l'on s'y prend trop tard, on ne peut jamais plus s'en débarrasser.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s10",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_033",
      "originalFrench": "Il encombre toute la planète.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s11",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_034",
      "originalFrench": "Il la perfore de ses racines.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s12",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_035",
      "originalFrench": "Et si la planète est trop petite, et si les baobabs sont trop nombreux, ils la font éclater.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p15:s13",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_036",
      "originalFrench": "\"C'est une question de discipline, me disait plus tard le petit prince.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p16:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_037",
      "originalFrench": "Quand on a terminé sa toilette du matin, il faut faire soigneusement la toilette de la planète.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p16:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_038",
      "originalFrench": "Il faut s'astreindre régulièrement à arracher les baobabs dès qu'on les distingue d'avec les rosiers auxquels ils ressemblent beaucoup quand ils sont très jeunes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p16:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_039",
      "originalFrench": "C'est un travail très ennuyeux, mais très facile.\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p16:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_040",
      "originalFrench": "Et un jour il me conseilla de m'appliquer à réussir un beau dessin, pour bien faire entrer ça dans la tête des enfants de chez moi. \"S'ils voyagent un jour, me disait-il, ça pourra leur servir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p17:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_041",
      "originalFrench": "Il est quelquefois sans inconvénient de remettre à plus tard son travail.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p17:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_042",
      "originalFrench": "Mais, s'il s'agit des baobabs, c'est toujours une catastrophe.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p17:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_043",
      "originalFrench": "J'ai connu une planète, habitée par un paresseux.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p17:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_044",
      "originalFrench": "Il avait négligé trois arbustes...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p17:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_045",
      "originalFrench": "Et, sur les indications du petit prince, j'ai dessiné cette planète-là.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_046",
      "originalFrench": "Je n'aime guère prendre le ton d'un moraliste.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_047",
      "originalFrench": "Mais le danger des baobabs est si peu connu, et les risques courus par celui qui s'égarerait dans un astéroïde sont si considérables, que, pour une fois, je fais exception à ma réserve.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_048",
      "originalFrench": "Je dis: \"Enfants!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_049",
      "originalFrench": "Faites attention aux baobabs!\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_050",
      "originalFrench": "C'est pour avertir mes amis du un danger qu'ils frôlaient depuis longtemps, comme moi-même, sans le connaître, que j'ai tant travaillé ce dessin-là.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_051",
      "originalFrench": "La leçon que je donnais en valait la peine.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_052",
      "originalFrench": "Vous vous demanderez peut-être: Pourquoi n'y a-t-il pas, dans ce livre, d'autres dessins aussi grandioses que le dessin des baobabs?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s8",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_053",
      "originalFrench": "La réponse est bien simple: J'ai essayé mais je n'ai pas pu réussir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s9",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_05_sentence_054",
      "originalFrench": "Quand j'ai dessiné les baobabs j'ai été animé par le sentiment de l'urgence.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap5:p18:s10",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_05_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    }
  ]
