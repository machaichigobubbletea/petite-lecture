  "sentences": [
    {
      "id": "chapter_09_sentence_001",
      "originalFrench": "Je crois qu'il profita, pour son évasion, d'une migration d'oiseaux sauvages.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_002",
      "originalFrench": "Au matin du départ il mit sa planète bien en ordre.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_003",
      "originalFrench": "Il ramona soigneusement ses volcans en activité.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_004",
      "originalFrench": "Il possédait deux volcans en activité.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_005",
      "originalFrench": "Et c'était bien commode pour faire chauffer le petit déjeuner du matin.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_006",
      "originalFrench": "Il possédait aussi un volcan éteint.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_007",
      "originalFrench": "Mais, comme il disait, \"On ne sait jamais!\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_008",
      "originalFrench": "Il ramona donc également le volcan éteint.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s8",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_009",
      "originalFrench": "S'ils sont bien ramonés, les volcans brûlent doucement et régulièrement, sans éruptions.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s9",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_010",
      "originalFrench": "Les éruptions volcaniques sont comme des feux de cheminée.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s10",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_011",
      "originalFrench": "Evidemment sur notre terre nous sommes beaucoup trop petits pour ramoner nos volcans.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s11",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_012",
      "originalFrench": "C'est pourquoi ils nous causent des tas d'ennuis.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p1:s12",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_013",
      "originalFrench": "Le petit prince arracha aussi, avec un peu de mélancolie, les dernières pousses de baobabs.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_014",
      "originalFrench": "Il croyait ne jamais devoir revenir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p2:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_015",
      "originalFrench": "Mais tout ces travaux familiers lui parurent, ce matin-là, extrêmement doux.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p2:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_016",
      "originalFrench": "Et, quand il arrosa une dernière fois la fleur, et se prépara à la mettre à l'abri sous son globe, il se découvrit l'envie de pleurer.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p2:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_017",
      "originalFrench": "-Adieu, dit-il à la fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_018",
      "originalFrench": "Mais elle ne lui répondit pas.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_019",
      "originalFrench": "-Adieu, répéta-t-il.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_020",
      "originalFrench": "La fleur toussa.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_021",
      "originalFrench": "Mais ce n'était pas à cause de son rhume.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p6:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_022",
      "originalFrench": "-J'ai été sotte, lui dit-elle enfin.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_023",
      "originalFrench": "Je te demande pardon.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p7:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_024",
      "originalFrench": "Tâche d'être heureux.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p7:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_025",
      "originalFrench": "Il fut surpris par l'absence de reproches.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_026",
      "originalFrench": "Il restait là tout déconcentré, le globe en l'air.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p8:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_027",
      "originalFrench": "Il ne comprenait pas cette douceur calme.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p8:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_028",
      "originalFrench": "-Mais oui, je t'aime, lui dit la fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_029",
      "originalFrench": "Tu n'en a rien su, par ma faute.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_030",
      "originalFrench": "Cela n'a aucune importance.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p9:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_031",
      "originalFrench": "Mais tu as été aussi sot que moi.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p9:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_032",
      "originalFrench": "Tâche d'être heureux...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap9:p9:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_09_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_09_sentence_033",
      "originalFrench": "Laisse ce globe tranquille.",
      "modernFrench": null,
      "japanese": null,
