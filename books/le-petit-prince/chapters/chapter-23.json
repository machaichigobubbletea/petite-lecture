      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_23_sentence_003",
      "originalFrench": "C'était un marchand de pilules perfectionnées qui apaisent la soif.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap23:p2:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_23_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_23_sentence_004",
      "originalFrench": "On en avale une par semaine et l'on n'éprouve plus le besoin de boire.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap23:p2:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_23_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_23_sentence_005",
      "originalFrench": "-Pourquoi vends-tu ça? dit le petit prince.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap23:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_23_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_23_sentence_006",
      "originalFrench": "-C'est une grosse économie de temps, dit le marchand.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap23:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_23_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_23_sentence_007",
      "originalFrench": "Les experts ont fait des calculs.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap23:p4:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_23_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_23_sentence_008",
      "originalFrench": "On épargne cinquante-trois minutes par semaine.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
