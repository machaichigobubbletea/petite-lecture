      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_23_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_23_sentence_010",
      "originalFrench": "-On en fait ce que l'on veut...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
