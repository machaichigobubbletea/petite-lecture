    },
    {
      "id": "chapter_23_sentence_002",
      "originalFrench": "-Bonjour, dit le marchand.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
