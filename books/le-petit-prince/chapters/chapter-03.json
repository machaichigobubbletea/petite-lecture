  "sentences": [
    {
      "id": "chapter_03_sentence_001",
      "originalFrench": "Il me fallut longtemps pour comprendre d'où il venait.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_002",
      "originalFrench": "Le petit prince, qui me posait beaucoup de questions, ne semblait jamais entendre les miennes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_003",
      "originalFrench": "Ce sont des mots prononcés par hasard qui, peu à peu, m'ont tout révélé.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_004",
      "originalFrench": "Ainsi, quand il aperçu pour la première fois mon avion (je ne dessinerai pas mon avion, c'est un dessin beaucoup trop compliqué pour moi) il me demanda:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p1:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_005",
      "originalFrench": "-Qu'est ce que c'est que cette chose-là?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_006",
      "originalFrench": "-Ce n'est pas une chose.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_007",
      "originalFrench": "Ça vole.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p3:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_008",
      "originalFrench": "C'est un avion.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p3:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_009",
      "originalFrench": "C'est mon avion.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p3:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_010",
      "originalFrench": "Et j'étais fier de lui apprendre que je volais.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_011",
      "originalFrench": "Alors il s'écria:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p4:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_012",
      "originalFrench": "-Comment! tu es tombé du ciel!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_013",
      "originalFrench": "-Oui, fis-je modestement.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_014",
      "originalFrench": "-Ah! ça c'est drôle!...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_015",
      "originalFrench": "Et le petit prince eut un très joli éclat de rire qui m'irrita beaucoup.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_016",
      "originalFrench": "Je désire que l'on prenne mes malheurs au sérieux.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p8:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_017",
      "originalFrench": "Puis il ajouta:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p8:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_018",
      "originalFrench": "-Alors, toi aussi tu viens du ciel!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_019",
      "originalFrench": "De quelle planète es-tu?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_020",
      "originalFrench": "J'entrevis aussitôt une lueur, dans le mystère de sa présence, et j'interrogeai brusquement:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p10:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_021",
      "originalFrench": "-Tu viens donc d'une autre planète?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p11:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_011",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_022",
      "originalFrench": "Mais il ne me répondit pas.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p12:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_012",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_023",
      "originalFrench": "Il hochait la tête doucement tout en regardant mon avion:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p12:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_012",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_024",
      "originalFrench": "-C'est vrai que, là-dessus, tu ne peux pas venir de bien loin...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p13:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_013",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_025",
      "originalFrench": "Et il s'enfonça dans une rêverie qui dura longtemps.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p14:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_014",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_026",
      "originalFrench": "Puis, sortant mon mouton de sa poche, il se plongea dans la contemplation de son trésor.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p14:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_014",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_027",
      "originalFrench": "Vous imaginez combien j'avais pu être intrigué par cette demi-confidence sur \"les autres planètes\".",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p15:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_028",
      "originalFrench": "Je m'efforçai donc d'en savoir plus long:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p15:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_029",
      "originalFrench": "-D'où viens-tu, mon petit bonhomme?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap3:p16:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_03_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_030",
      "originalFrench": "Où est-ce \"chez toi\"?",
      "modernFrench": null,
      "japanese": null,
