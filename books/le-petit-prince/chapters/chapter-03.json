      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_03_sentence_033",
      "originalFrench": "-Ce qui est bien, avec la caisse que tu m'as donnée, c'est que, la nuit, ça lui servira de maison.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
