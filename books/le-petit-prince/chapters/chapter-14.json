  "sentences": [
    {
      "id": "chapter_14_sentence_001",
      "originalFrench": "La cinquième planète était très curieuse.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_002",
      "originalFrench": "C'était la plus petite de toutes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_003",
      "originalFrench": "Il y avait là juste assez de place pour loger un réverbère et un allumeur de réverbères.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_004",
      "originalFrench": "Le petit prince ne parvenait pas à s'expliquer à quoi pouvaient servir, quelque part dans le ciel, sur une planète sans maison, ni population, un réverbère et un allumeur de réverbères.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p1:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_005",
      "originalFrench": "Cependant il se dit en lui-même:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p1:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_006",
      "originalFrench": "- Peut-être bien que cet homme est absurde.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_007",
      "originalFrench": "Cependant il est moins absurde que le roi, que le vaniteux, que le businessman et que le buveur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p2:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_008",
      "originalFrench": "Au moins son travail a-t-il un sens.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p2:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_009",
      "originalFrench": "Quand il allume son réverbère, c'est comme s'il faisait naître une étoile de plus, ou une fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p2:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_010",
      "originalFrench": "Quand il éteint son réverbère ça endort la fleur ou l'étoile.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p2:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_011",
      "originalFrench": "C'est une occupation très jolie.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p2:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_012",
      "originalFrench": "C'est véritablement utile puisque c'est joli.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p2:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_013",
      "originalFrench": "Lorsqu'il aborda la planète il salua respectueusement l'allumeur:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_014",
      "originalFrench": "-Bonjour.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_015",
      "originalFrench": "Pourquoi viens-tu d'éteindre ton réverbère?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p4:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_016",
      "originalFrench": "-C'est la consigne, répondit l'allumeur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_017",
      "originalFrench": "Bonjour.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p5:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_018",
      "originalFrench": "-Qu'est-ce que la consigne?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_019",
      "originalFrench": "-C'est d'éteindre mon réverbère.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_020",
      "originalFrench": "Bonsoir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p7:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_021",
      "originalFrench": "Et il le ralluma.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_022",
      "originalFrench": "-Mais pourquoi viens-tu de rallumer?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_023",
      "originalFrench": "-C'est la consigne, répondit l'allumeur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p10:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_024",
      "originalFrench": "-Je ne comprends pas, dit le petit prince.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p11:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_011",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_025",
      "originalFrench": "-Il n'y a rien à comprendre, dit l'allumeur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap14:p12:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_14_paragraph_012",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_026",
      "originalFrench": "La consigne c'est la consigne.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
