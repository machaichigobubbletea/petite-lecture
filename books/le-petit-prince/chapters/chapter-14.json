      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_14_sentence_069",
      "originalFrench": "C'est, peut-être, parce qu'il s'occupe d'autre chose que de soi-même.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
