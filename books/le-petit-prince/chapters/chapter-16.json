  "sentences": [
    {
      "id": "chapter_16_sentence_001",
      "originalFrench": "La septième planète fut donc la Terre.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_002",
      "originalFrench": "La Terre n'est pas une planète quelconque!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_003",
      "originalFrench": "On y compte cent onze rois (en n'oubliant pas, bien sûr, les rois nègres), sept mille géographes, neuf cent mille businessmen, sept millions et demi d'ivrognes, trois cent onze millions de vaniteux, c'est-àdire environ deux milliards de grandes personnes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p2:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_004",
      "originalFrench": "Pour vous donner une idée des dimensions de la Terre je vous dirai qu'avant l'invention de l'électricité on y devait entretenir, sur l'ensemble des six continents, une véritable armée de quatre cent soixante-deux mille cinq cent onze allumeurs de réverbères.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_005",
      "originalFrench": "Vu d'un peu loin ça faisait un effet splendide.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_006",
      "originalFrench": "Les mouvements de cette armée étaient réglés comme ceux d'un ballet d'opéra.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_007",
      "originalFrench": "D'abord venait le tour des allumeurs de réverbères de Nouvelle-Zélande et d'Australie.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_008",
      "originalFrench": "Puis ceux-ci, ayant allumé leurs lampions, s'en allaient dormir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_009",
      "originalFrench": "Alors entraient à leur tour dans la danse les allumeurs de réverbères de Chine et de Sibérie.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_010",
      "originalFrench": "Puis eux aussi s'escamotaient dans les coulisses.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_011",
      "originalFrench": "Alors venait le tour des allumeurs de réverbères de Russie et des Indes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_012",
      "originalFrench": "Puis de ceux d'Afrique et d'Europe.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s8",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_013",
      "originalFrench": "Puis de ceux d'Amérique de Sud.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s9",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_014",
      "originalFrench": "Puis de ceux d'Amérique de Nord.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s10",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_015",
      "originalFrench": "Et jamais ils ne se trompaient dans leur ordre d'entrée en scène.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s11",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_016",
      "originalFrench": "C'était grandiose.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p4:s12",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_16_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_16_sentence_017",
      "originalFrench": "Seuls, l'allumeur de l'unique réverbère de pôle Nord, et son confrère de l'unique réverbère du pôle Sud, menaient des vies d'oisiveté et de nonchalance: ils travaillaient deux fois par an.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap16:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
