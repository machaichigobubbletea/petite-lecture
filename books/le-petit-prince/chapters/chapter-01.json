  "sentences": [
    {
      "id": "chapter_01_sentence_001",
      "originalFrench": "Lorsque j'avais six ans j'ai vu, une fois, une magnifique image, dans un livre sur la forêt vierge qui s'appelait \"Histoires Vécues\".",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_002",
      "originalFrench": "Ça représentait un serpent boa qui avalait un fauve.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_003",
      "originalFrench": "Voilà la copie du dessin.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_004",
      "originalFrench": "On disait dans le livre: \"Les serpents boas avalent leur proie tout entière, sans la mâcher.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_005",
      "originalFrench": "Ensuite ils ne peuvent plus bouger et ils dorment pendant les six mois de leur digestion\".",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p2:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_006",
      "originalFrench": "J'ai alors beaucoup réfléchi sur les aventures de la jungle et, à mon tour, j'ai réussi, avec un crayon de couleur, à tracer mon premier dessin.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_007",
      "originalFrench": "Mon dessin numéro 1.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p3:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_008",
      "originalFrench": "Il était comme ça:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p3:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_009",
      "originalFrench": "J'ai montré mon chef-d'oeuvre aux grandes personnes et je leur ai demandé si mon dessin leur faisait peur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_010",
      "originalFrench": "Elles m'ont répondu: \"Pourquoi un chapeau ferait-il peur?\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_011",
      "originalFrench": "Mon dessin ne représentait pas un chapeau.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_012",
      "originalFrench": "Il représentait un serpent boa qui digérait un éléphant.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p6:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_013",
      "originalFrench": "J'ai alors dessiné l'intérieur du serpent boa, afin que les grandes personnes puissent comprendre.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p6:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_014",
      "originalFrench": "Elles ont toujours besoin d'explications.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p6:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_015",
      "originalFrench": "Mon dessin numéro 2 était comme ça:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p6:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_016",
      "originalFrench": "Les grandes personnes m'ont conseillé de laisser de côté les dessins de serpents boas ouverts ou fermés, et de m'intéresser plutôt à la géographie, à l'histoire, au calcul et à la grammaire.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_017",
      "originalFrench": "C'est ainsi que j'ai abandonné, à l'âge de six ans, une magnifique carrière de peinture.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p7:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_018",
      "originalFrench": "J'avais été découragé par l'insuccès de mon dessin numéro 1 et de mon dessin numéro 2.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p7:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_019",
      "originalFrench": "Les grandes personnes ne comprennent jamais rien toutes seules, et c'est fatigant, pour les enfants, de toujours et toujours leur donner des explications.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p7:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_020",
      "originalFrench": "J'ai donc dû choisir un autre métier et j'ai appris à piloter des avions.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_021",
      "originalFrench": "J'ai volé un peu partout dans le monde.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p8:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_022",
      "originalFrench": "Et la géographie, c'est exact, m'a beaucoup servi.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p8:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_023",
      "originalFrench": "Je savais reconnaître, du premier coup d'oeil, la Chine de l'Arizona.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p8:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_024",
      "originalFrench": "C'est très utile, si l'on s'est égaré pendant la nuit.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p8:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_025",
      "originalFrench": "J'ai ainsi eu, au cours de ma vie, des tas de contacts avec des tas de gens sérieux.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_026",
      "originalFrench": "J'ai beaucoup vécu chez les grandes personnes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_027",
      "originalFrench": "Je les ai vues de très près. ça n'a pas trop amélioré mon opinion.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p9:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_028",
      "originalFrench": "Quand j'en rencontrais une qui me paraissait un peu lucide, je faisais l'expérience sur elle de mon dessin numéro 1 que j'ai toujours conservé.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p10:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_029",
      "originalFrench": "Je voulais savoir si elle était vraiment compréhensive.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p10:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_030",
      "originalFrench": "Mais toujours elle me répondait: \"C'est un chapeau.\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p10:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_031",
      "originalFrench": "Alors je ne lui parlais ni de serpents boas, ni de forêts vierges, ni d'étoiles.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p10:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_032",
      "originalFrench": "Je me mettais à sa portée.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p10:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_033",
      "originalFrench": "Je lui parlais de bridge, de golf, de politique et de cravates.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap1:p10:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_01_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_01_sentence_034",
      "originalFrench": "Et la grande personne était bien contente de connaître un homme aussi raisonnable.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
