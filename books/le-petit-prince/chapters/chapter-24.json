  "sentences": [
    {
      "id": "chapter_24_sentence_001",
      "originalFrench": "Nous en étions au huitième jour de ma panne dans le désert, et j'avais écouté l'histoire du marchand en buvant la dernière goutte de ma provision d'eau:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_002",
      "originalFrench": "-Ah! dis-je au petit prince, ils sont bien jolis, tes souvenirs, mais je n'ai pas encore réparé mon avion, je n'ai plus rien à boire, et je serais heureux, moi aussi, si je pouvais marcher tout doucement vers une fontaine!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_003",
      "originalFrench": "-Mon ami le renard, me dit-il...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_004",
      "originalFrench": "-Mon petit bonhomme, il ne s'agit plus du renard!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_005",
      "originalFrench": "-Pourquoi?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_006",
      "originalFrench": "-Parce qu'on va mourir de soif...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_007",
      "originalFrench": "Il ne comprit pas mon raisonnement, il me répondit:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_008",
      "originalFrench": "-Ç'est bien d'avoir eu un ami, même si l'on va mourir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_009",
      "originalFrench": "Moi, je suis bien content d'avoir eu un ami renard...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p8:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_010",
      "originalFrench": "Il ne mesure pas le danger, me dis-je.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_011",
      "originalFrench": "Il n'a jamais ni faim ni soif.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_012",
      "originalFrench": "Un peu de soleil lui suffit...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p9:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_013",
      "originalFrench": "Mais il me regarda et répondit à ma pensée:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p10:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_014",
      "originalFrench": "-J'ai soif aussi...cherchons un puits...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p11:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_011",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_015",
      "originalFrench": "J'eus un geste de lassitude: il est absurde de chercher un puits, au hasard, dans l'immensité du désert.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p12:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_012",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_016",
      "originalFrench": "Cependant nous nous mîmes en marche.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p12:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_012",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_017",
      "originalFrench": "Quand nous eûmes marché, des heures, en silence, la nuit tomba, et les étoiles commencèrent de s'éclairer.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p13:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_013",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_018",
      "originalFrench": "Je les apercevais comme un rêve, ayant un peu de fièvre, à cause de ma soif.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p13:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_013",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_019",
      "originalFrench": "Les mots du petit prince dansaient dans ma mémoire:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p13:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_013",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_020",
      "originalFrench": "-Tu as donc soif, toi aussi? lui demandai-je.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p14:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_014",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_021",
      "originalFrench": "Mais il ne répondit pas à ma question.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p15:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_022",
      "originalFrench": "Il me dit simplement:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p15:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_023",
      "originalFrench": "-L'eau peut aussi être bonne pour le coeur...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p16:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_024",
      "originalFrench": "Je ne compris pas sa réponse mais je me tus...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p17:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_025",
      "originalFrench": "Je savais bien qu'il ne fallait pas l'interroger.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p17:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_026",
      "originalFrench": "Il était fatigué.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p18:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_027",
      "originalFrench": "Il s'assit.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p18:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_028",
      "originalFrench": "Je m'assis auprès de lui.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p18:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_029",
      "originalFrench": "Et, après un silence, il dit encore:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p18:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_030",
      "originalFrench": "-Les étoiles sont belles, à cause d'une fleur que l'on ne voit pas...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p19:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_019",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_031",
      "originalFrench": "Je répondis \"bien sûr\" et je regardai, sans parler, les plis du sable sous la lune.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p20:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_020",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_032",
      "originalFrench": "-Le désert est beau, ajouta-t-il...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p21:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_021",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_033",
      "originalFrench": "Et c'était vrai.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p22:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_034",
      "originalFrench": "J'ai toujours aimé le désert.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p22:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_035",
      "originalFrench": "On s'assoit sur une dune de sable.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p22:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_036",
      "originalFrench": "On ne voit rien.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p22:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_037",
      "originalFrench": "On n'entend rien.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p22:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_038",
      "originalFrench": "Et cependant quelque chose rayonne en silence...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p22:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_039",
      "originalFrench": "-Ce qui embellit le désert, dit le petit prince, c'est qu'il cache un puits quelque part...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p23:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_023",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_040",
      "originalFrench": "Je fus surpris de comprendre soudain ce mystérieux rayonnement du sable.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p24:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_024",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_041",
      "originalFrench": "Lorsque j'étais petit garçon, j'habitais une maison ancienne, et la légende racontait qu'un trésor y était enfoui.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p24:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_024",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_042",
      "originalFrench": "Bien sûr, jamais personne n'a su le découvrir, ni peut-être même ne l'a cherché.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p24:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_024",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_043",
      "originalFrench": "Mais il enchantait toute cette maison.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p24:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_024",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_044",
      "originalFrench": "Ma maison cachait un secret au fond de son coeur...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p24:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_024",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_045",
      "originalFrench": "-Oui, dis-je au petit prince, qu'il s'agisse de la maison, des étoiles ou du désert, ce qui fait leur beauté est invisible!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p25:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_025",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_046",
      "originalFrench": "-Je suis content, dit-il, que tu sois d'accord avec mon renard.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p26:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_026",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_047",
      "originalFrench": "Comme le petit prince s'endormait, je le pris dans mes bras, et me remis en route.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p27:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_027",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_048",
      "originalFrench": "J'étais ému.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p27:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_027",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_049",
      "originalFrench": "Il me semblait porter un trésor fragile.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p27:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_027",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_050",
      "originalFrench": "Il me semblait même qu'il n'y eût rien de plus fragile sur la Terre.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p27:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_027",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_051",
      "originalFrench": "Je regardais, à la lumière de la lune, ce front pâle, ces yeux clos, ces mèches de cheveux qui tremblaient au vent, et je me disais: \"Ce que je vois là n'est qu'une écorce.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p27:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_027",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_052",
      "originalFrench": "Le plus important est invisible...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p27:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_027",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_053",
      "originalFrench": "Comme ses lèvres entr'ouvertes ébauchaient un demi-sourire je me dis encore: \"Ce qui m'émeut si fort de ce petit prince endormi, c'est sa fidélité pour une fleur, c'est l'image d'une rose qui rayonne en lui comme la flamme d'une lampe, même quand il dort...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p28:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_028",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_054",
      "originalFrench": "Et je le devinai plus fragile encore.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p28:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_028",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_055",
      "originalFrench": "Il faut bien protéger les lampes: un coup de vent peut les éteindre...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p28:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_028",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_24_sentence_056",
      "originalFrench": "Et, marchant ainsi, je découvris le puits au lever du jour.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap24:p29:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_24_paragraph_029",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    }
  ]
}
