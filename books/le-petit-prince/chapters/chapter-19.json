      "phrases": []
    },
    {
      "id": "chapter_19_sentence_013",
      "originalFrench": "Je suis seul...répondit l'écho.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
