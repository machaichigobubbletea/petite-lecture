  "sentences": [
    {
      "id": "chapter_19_sentence_001",
      "originalFrench": "Le petit prince fit l'ascension d'une haute montagne.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_002",
      "originalFrench": "Les seules montagnes qu'il eût jamais connues étaient les trois volcans qui lui arrivaient au genou.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_003",
      "originalFrench": "Et il se servait du volcan éteint comme d'un tabouret. \"D'une montagne haute comme celle-ci, se dit-il donc, j'apercevrai d'un coup toute la planète et tous les hommes...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_004",
      "originalFrench": "Mais il n'aperçut rien que des aiguilles de roc bien aiguisées.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p1:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_005",
      "originalFrench": "-Bonjour, dit-il à tout hasard.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
