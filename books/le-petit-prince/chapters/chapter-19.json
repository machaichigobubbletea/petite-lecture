      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_014",
      "originalFrench": "\"Quelle drôle de planète! pensa-t-il alors.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_015",
      "originalFrench": "Elle est toute sèche, et toute pointue et toute salée.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p8:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_016",
      "originalFrench": "Et les hommes manquent d'imagination.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_017",
      "originalFrench": "Ils répètent ce qu'on leur dit...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap19:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_19_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_018",
      "originalFrench": "Chez moi j'avais une fleur: elle parlait toujours la première...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
