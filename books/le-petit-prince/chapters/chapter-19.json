      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_19_sentence_009",
      "originalFrench": "-Qui êtes-vous? dit le petit prince.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
