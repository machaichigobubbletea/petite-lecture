  "sentences": [
    {
      "id": "chapter_08_sentence_001",
      "originalFrench": "J'appris bien vite à mieux connaître cette fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_002",
      "originalFrench": "Il y avait toujours eu, sur la planète du petit prince, des fleurs très simples, ornées d'un seul rang de pétales, et qui ne tenaient point de place, et qui ne dérangeaient personne.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_003",
      "originalFrench": "Elles apparaissaient un matin dans l'herbe, et puis elles s'éteignaient le soir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_004",
      "originalFrench": "Mais celle-là avait germé un jour, d'une graine apportée d'on ne sait où, et le petit prince avait surveillé de très près cette brindille qui ne ressemblait pas aux autres brindilles.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_005",
      "originalFrench": "Ça pouvait être un nouveau genre de baobab.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_006",
      "originalFrench": "Mais l'arbuste cessa vite de croître, et commença de préparer une fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_007",
      "originalFrench": "Le petit prince, qui assistait à l'installation d'un bouton énorme, sentait bien qu'il en sortirait une apparition miraculeuse, mais la fleur n'en finissait pas de se préparer à être belle, à l'abri de sa chambre verte.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_008",
      "originalFrench": "Elle choisissait avec soin ses couleurs.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s8",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_009",
      "originalFrench": "Elle s'habillait lentement, elle ajustait un à un ses pétales.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s9",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_010",
      "originalFrench": "Elle ne voulait pas sortir toute fripée comme les coquelicots.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s10",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_011",
      "originalFrench": "Elle ne voulait apparaître que dans le plein rayonnement de sa beauté.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s11",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_012",
      "originalFrench": "Eh! oui.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s12",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_013",
      "originalFrench": "Elle était très coquette!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s13",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_014",
      "originalFrench": "Sa toilette mystérieuse avait donc duré des jours et des jours.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s14",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_015",
      "originalFrench": "Et puis voici qu'un matin, justement à l'heure du lever du soleil, elle s'était montrée.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p1:s15",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_016",
      "originalFrench": "Et elle, qui avait travaillé avec tant de précision, dit en bâillant:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_017",
      "originalFrench": "-Ah! je me réveille à peine...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_018",
      "originalFrench": "Je vous demande pardon...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p3:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_019",
      "originalFrench": "Je suis encore toute décoiffée...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p3:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_020",
      "originalFrench": "Le petit prince, alors, ne put contenir son admiration:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_021",
      "originalFrench": "-Que vous êtes belle!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_022",
      "originalFrench": "-N'est-ce pas, répondit doucement la fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_023",
      "originalFrench": "Et je suis née en même temps que le soleil...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p6:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_024",
      "originalFrench": "Le petit prince devina bien qu'elle n'était pas trop modeste, mais elle était si émouvante!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_025",
      "originalFrench": "-C'est l'heure, je crois, du petit déjeuner, avait-elle bientôt ajouté, auriez-vous la bonté de penser à moi...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_026",
      "originalFrench": "Et le petit prince, tout confus, ayant été chercher un arrosoir d'eau fraîche, avait servi la fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_027",
      "originalFrench": "Ainsi l'avait-elle bien vite tourmenté par sa vanité un peu ombrageuse.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p10:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_028",
      "originalFrench": "Un jour, par exemple, parlant de ses quatre épines, elle avait dit au petit prince:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p10:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_029",
      "originalFrench": "-Ils peuvent venir, les tigres, avec leurs griffes!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p11:s1",
