      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_030",
      "originalFrench": "-Il n'y a pas de tigres sur ma planète, avait objecté le petit prince, et puis les tigres ne mangent pas d'herbe.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p12:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_012",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_031",
      "originalFrench": "-Je ne suis pas une herbe, avait doucement répondu la fleur.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p13:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_013",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_032",
      "originalFrench": "-Pardonnez-moi...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p14:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_014",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_033",
      "originalFrench": "-Je ne crains rien des tigres, mais j'ai horreur des courants d'air.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p15:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_034",
      "originalFrench": "Vous n'auriez pas un paravent?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p15:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_015",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_035",
      "originalFrench": "\"Horreur des courants d'air...ce n'est pas de chance, pour une plante, avait remarqué le petit prince.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p16:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_036",
      "originalFrench": "Cette fleur est bien compliquée...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p16:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_016",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_037",
      "originalFrench": "-Le soir vous me mettrez sous globe.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p17:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_038",
      "originalFrench": "Il fait très froid chez vous.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p17:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_039",
      "originalFrench": "C'est mal installé.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p17:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_040",
      "originalFrench": "Là d'ou je viens...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p17:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_017",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_041",
      "originalFrench": "Mais elle s'était interrompue.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p18:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_042",
      "originalFrench": "Elle était venue sous forme de graine.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p18:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_043",
      "originalFrench": "Elle n'avait rien pu connaître des autres mondes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p18:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_044",
      "originalFrench": "Humiliée de s'être laissé surprendre à préparer un mensonge aussi naïf, elle avait toussé deux ou trois fois, pour mettre le petit prince dans son tort:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p18:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_018",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_045",
      "originalFrench": "-Ce paravent?...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p19:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_019",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_046",
      "originalFrench": "-J'allais le chercher mais vous me parliez!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p20:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_020",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_047",
      "originalFrench": "Alors elle avait forcé sa toux pour lui infliger quand même des remords.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p21:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_021",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_048",
      "originalFrench": "Ainsi le petit prince, malgré la bonne volonté de son amour, avait vite douté d'elle.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p22:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_049",
      "originalFrench": "Il avait pris au sérieux des mots sans importance, et était devenu très malheureux.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p22:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_022",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_050",
      "originalFrench": "\"J'aurais dû ne pas l'écouter, me confia-t-il un jour, il ne faut jamais écouter les fleurs.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p23:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_023",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_051",
      "originalFrench": "Il faut les regarder et les respirer.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p23:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_023",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_052",
      "originalFrench": "La mienne embaumait ma planète, mais je ne savais pas m'en réjouir.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p23:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_023",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_053",
      "originalFrench": "Cette histoire de griffes, qui m'avait tellement agacé, eût dû m'attendrir...\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p23:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_023",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_054",
      "originalFrench": "Il me confia encore:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p24:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_024",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_055",
      "originalFrench": "\"Je n'ai alors rien su comprendre!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p25:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_025",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_056",
      "originalFrench": "J'aurais dû la juger sur les actes et non sur les mots.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p25:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_025",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_057",
      "originalFrench": "Elle m'embaumait et m'éclairait.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p25:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_025",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_058",
      "originalFrench": "Je n'aurais jamais dû m'enfuir!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p25:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_025",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_059",
      "originalFrench": "J'aurais dû deviner sa tendresse derrière ses pauvres ruses.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p25:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_025",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_060",
      "originalFrench": "Les fleurs sont si contradictoires!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap8:p25:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_08_paragraph_025",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_08_sentence_061",
      "originalFrench": "Mais j'étais trop jeune pour savoir l'aimer.\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
