  "sentences": [
    {
      "id": "chapter_04_sentence_001",
      "originalFrench": "J'avais ainsi appris une seconde chose très importante: C'est que sa planète d'origine était à peine plus grande qu'une maison!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_002",
      "originalFrench": "Ça ne pouvait pas m'étonner beaucoup.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_003",
      "originalFrench": "Je savais bien qu'en dehors des grosses planètes comme la Terre, Jupiter, Mars, Vénus, auxquelles on a donné des noms, il y en a des centaines d'autres qui sont quelque-fois si petites qu'on a beaucoup de mal à les apercevoir au télescope.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p2:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_004",
      "originalFrench": "Quand un astronome découvre l'une d'elles, il lui donne pour nom un numéro.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p2:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_005",
      "originalFrench": "Il l'appelle par exemple: \"l'astéroïde 3251.\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p2:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_006",
      "originalFrench": "J'ai de sérieuses raisons de croire que la planète d'ou venait le petit prince est l'astéroïde B 612.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_007",
      "originalFrench": "Cet astéroïde n'a été aperçu qu'une fois au télescope, en 1909, par un astronome turc.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_008",
      "originalFrench": "Il avait fait alors une grande démonstration de sa découverte à un Congrès International d'Astronomie.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_009",
      "originalFrench": "Mais personne ne l'avait cru à cause de son costume.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_010",
      "originalFrench": "Les grandes personnes sont comme ça.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p6:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_011",
      "originalFrench": "Heureusement pour la réputation de l'astéroïde B 612, un dictateur turc imposa à son peuple, sous peine de mort, de s'habiller à l'européenne.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_012",
      "originalFrench": "L'astronome refit sa démonstration en 1920, dans un habit très élégant.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p7:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_013",
      "originalFrench": "Et cette fois-ci tout le monde fut de son avis.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p7:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_014",
      "originalFrench": "Si je vous ai raconté ces détails sur l'astéroïde B 612 et si je vous ai confié son numéro, c'est à cause des grandes personnes.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_015",
      "originalFrench": "Les grandes personnes aiment les chiffres.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_016",
      "originalFrench": "Quand vous leur parlez d'un nouvel ami, elles ne vous questionnent jamais sur l'essentiel.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_017",
      "originalFrench": "Elles ne vous disent jamais: \"Quel est le son de sa voix?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_018",
      "originalFrench": "Quels sont les jeux qu'il préfère?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_019",
      "originalFrench": "Est-ce qu'il collectionne les papillons?\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_020",
      "originalFrench": "Elles vous demandent: \"Quel âge a-t-il?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_021",
      "originalFrench": "Combien a-t-il de frères?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s8",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_022",
      "originalFrench": "Combien pèse-t-il?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s9",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_023",
      "originalFrench": "Combien gagne son père?\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s10",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_024",
      "originalFrench": "Alors seulement elles croient le connaître.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s11",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_025",
      "originalFrench": "Si vous dites aux grandes personnes: \"J'ai vu une belle maison en briques roses, avec des géraniums aux fenêtres et des colombes sur le toit...\" elles ne parviennent pas à s'imaginer cette maison.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s12",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_026",
      "originalFrench": "Il faut leur dire: \"J'ai vu une maison de cent mille francs.\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s13",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_027",
      "originalFrench": "Alors elles s'écrient: \"Comme c'est joli!\"",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p8:s14",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_028",
      "originalFrench": "Ainsi, si vous leur dites: \"La preuve que le petit prince a existé c'est qu'il était ravissant, qu'il riait, et qu'il voulait un mouton.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_029",
      "originalFrench": "Quand on veut un mouton, c'est la preuve qu'on existe\" elles hausseront les épaules et vous traiteront d'enfant!",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_030",
      "originalFrench": "Mais si vous leur dites: \"La planète d'où il venait est l'astéroïde B 612\" alors elles seront convaincues, et elles vous laisseront tranquille avec leurs questions.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p9:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_031",
      "originalFrench": "Elles sont comme ça.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap4:p9:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_04_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_04_sentence_032",
