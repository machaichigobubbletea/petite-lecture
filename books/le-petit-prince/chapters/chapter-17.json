  "sentences": [
    {
      "id": "chapter_17_sentence_001",
      "originalFrench": "Quand on veut faire de l'esprit, il arrive que l'on mente un peu.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p1:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_002",
      "originalFrench": "Je n'ai pas été très honnête en vous parlant des allumeurs de réverbères.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p1:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_003",
      "originalFrench": "Je risque de donner une fausse idée de notre planète à ceux qui ne la connaissent pas.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p1:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_004",
      "originalFrench": "Les hommes occupent très peu de place sur la Terre.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p1:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_005",
      "originalFrench": "Si les deux milliards d'habitants qui peuplent la Terre se tenaient debout et un peu serrés, comme pour un meeting, ils logeraient aisément sur une place publique de vingt milles de long sur vingt milles de large.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p1:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_006",
      "originalFrench": "On pourrait entasser l'humanité sur le moindre petit îlot du Pacifique.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p1:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_001",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_007",
      "originalFrench": "Les grandes personnes, bien sûr, ne vous croiront pas.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_008",
      "originalFrench": "Elles s'imaginent tenir beaucoup de place.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_009",
      "originalFrench": "Elles se voient importantes comme des baobabs.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_010",
      "originalFrench": "Vous leur conseillerez donc de faire le calcul.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s4",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_011",
      "originalFrench": "Elles adorent les chiffres: ça leur plaira.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s5",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_012",
      "originalFrench": "Mais ne perdez pas votre temps à ce pensum.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s6",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_013",
      "originalFrench": "C'est inutile.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s7",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_014",
      "originalFrench": "Vous avez confiance en moi.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p2:s8",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_002",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_015",
      "originalFrench": "Le petit prince, une fois sur Terre, fut donc bien surpris de ne voir personne.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p3:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_016",
      "originalFrench": "Il avait déjà peur de s'être trompé de planète, quand un anneau couleur de lune remua dans le sable.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p3:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_003",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_017",
      "originalFrench": "-Bonne nuit, fit le petit prince à tout hasard.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p4:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_004",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_018",
      "originalFrench": "-Bonne nuit, fit le serpent.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p5:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_005",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_019",
      "originalFrench": "-Sur quelle planète suis-je tombé? demanda le petit prince.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p6:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_006",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_020",
      "originalFrench": "-Sur la Terre, en Afrique, répondit le serpent.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p7:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_007",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_021",
      "originalFrench": "-Ah!...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p8:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_022",
      "originalFrench": "Il n'y a donc personne sur la Terre?",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p8:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_008",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_023",
      "originalFrench": "-Ici c'est le désert.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p9:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_024",
      "originalFrench": "Il n'y a personne dans les déserts.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p9:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_025",
      "originalFrench": "La Terre est grande, dit le serpent.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p9:s3",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_009",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_026",
      "originalFrench": "Le petit prince s'assit sur une pierre et leva les yeux vers le ciel:",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p10:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_010",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_027",
      "originalFrench": "-Je me demande, dit-il, si les étoiles sont éclairées afin que chacun puisse un jour retrouver la sienne.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p11:s1",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_011",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_028",
      "originalFrench": "Regarde ma planète.",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
      "sourceEdition": "project-gutenberg-australia-0300771h",
      "sourceReference": "#ppchap17:p11:s2",
      "textVersion": "pga-0300771h-import-v1",
      "paragraphId": "chapter_17_paragraph_011",
      "phraseSegmentationStatus": "not-reviewed",
      "phrases": []
    },
    {
      "id": "chapter_17_sentence_029",
      "originalFrench": "Elle est juste au-dessus de nous...",
      "modernFrench": null,
      "japanese": null,
      "english": null,
      "grammarNotes": null,
      "audio": null,
      "learningData": null,
